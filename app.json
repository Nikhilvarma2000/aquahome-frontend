{
  "expo": {
    "name": "AquaHome",
    "slug": "aqua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/aqua_home.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/aqua_home.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquahome.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aquahome.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AquaHome to use your location to find nearby service areas."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "25454bc9-af5e-4b6d-b5f1-05e88764359f"
      }
    },
    "owner": "cherry93479"
  }
}
